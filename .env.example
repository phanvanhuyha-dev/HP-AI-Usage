# Cổng máy chủ cục bộ (mặc định 6736) / Local server port (default 6736)
PORT=6736

# Tùy chọn: khóa API Perplexity để theo dõi trạng thái Perplexity
# Optional: Perplexity API key to monitor Perplexity status
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Hiện chưa dùng, chỉ lưu sẵn cho lần mở rộng sau
# Not used yet, only stored for a future extension
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
